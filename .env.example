# ============================================================================
# Smriti - environment contract
# Copy to .env and fill in. Never commit .env.
# ============================================================================

# ---------------------------------------------------------------------------
# CONTROL PLANE (api/)
# ---------------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO

# SQLite for zero-setup local dev; swap for the Neon pooled URL in production.
#   postgresql+asyncpg://USER:PASS@ep-xxx-pooler.REGION.aws.neon.tech/smriti?ssl=require
DATABASE_URL=sqlite+aiosqlite:///./local.db

# Where image bytes live: postgres | local | s3
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./storage

# Optional S3/R2-compatible storage (only read when STORAGE_BACKEND=s3)
S3_ENDPOINT_URL=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# Keys GPU workers authenticate with (X-API-Key).
#   python -c "import secrets;print('smw_'+secrets.token_urlsafe(32))"
WORKER_API_KEYS=smw_dev_local_worker_key_change_me
# Admin key for featuring showcase pairs, pruning, publishing eval runs.
#   python -c "import secrets;print('sma_'+secrets.token_urlsafe(32))"
ADMIN_API_KEY=sma_dev_local_admin_key_change_me

# Anonymous public quotas
PUBLIC_JOBS_PER_HOUR=12
PUBLIC_JOBS_PER_DAY=40
MAX_QUEUE_DEPTH=120

# Job lease / retry behaviour (drives the fault-tolerance story)
JOB_LEASE_SECONDS=180
JOB_MAX_ATTEMPTS=3
WORKER_OFFLINE_AFTER_SECONDS=45
CLAIM_LONG_POLL_SECONDS=25

# Upload bounds. Sources above MAX_SOURCE_PIXELS are downscaled at the edge,
# which caps storage and worker VRAM in one place.
MAX_UPLOAD_BYTES=26214400
MAX_SOURCE_PIXELS=4000000
MAX_RESULT_PIXELS=32000000

# Privacy: uploaded photographs are personal. Sources and results are private and
# expire on a short clock; the hand-curated showcase is exempt.
PRIVATE_RETENTION_HOURS=48
IMAGE_RETENTION_DAYS=30
IMAGE_MAX_COUNT=1500

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------------------------------------------------------------------------
# GPU WORKER (worker/)
# ---------------------------------------------------------------------------
SMRITI_API_URL=http://127.0.0.1:8000
SMRITI_WORKER_KEY=smw_dev_local_worker_key_change_me
WORKER_NAME=local-worker

INPAINT_MODEL_ID=stable-diffusion-v1-5/stable-diffusion-inpainting
UPSCALE_MODEL_ID=stabilityai/stable-diffusion-x4-upscaler
REFINE_MODEL_ID=stable-diffusion-v1-5/stable-diffusion-v1-5

# Which pipeline stages this worker will accept. The control plane only hands it
# jobs whose every stage appears here, so a partial worker is safe to run.
WORKER_STAGES=descratch,denoise,colorize,upscale,face_enhance
WORKER_TIERS=fast,balanced
# Largest output this worker will accept, in pixels.
WORKER_MAX_PIXELS=12000000

# 4GB-VRAM friendly. Turn slicing off on a bigger card for speed.
TORCH_DTYPE=float16
ATTENTION_SLICING=1
VAE_SLICING=1
VAE_TILING=1
CPU_OFFLOAD=0

# Tiling bounds peak VRAM independently of photograph size.
UPSCALE_TILE=384
UPSCALE_OVERLAP=48
INPAINT_TILE=512

FACE_MIN_SIZE=48
FACE_PADDING=0.35
MAX_FACES=12

HF_HOME=./hf_cache

# ---------------------------------------------------------------------------
# EVALUATION (ml/)
# ---------------------------------------------------------------------------
# Clean ground-truth photographs are fetched from Pexels, then degraded.
PEXELS_ACCESS_KEY=

# ---------------------------------------------------------------------------
# FRONTEND (web/)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
